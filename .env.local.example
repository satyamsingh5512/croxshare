# Pusher Channels — get these from https://pusher.com (free tier is enough)
# 1. Create a new app at https://dashboard.pusher.com
# 2. Enable "Presence Channels" and "Client Events" in App → Settings → Feature Flags
# 3. Copy the keys below

NEXT_PUBLIC_PUSHER_KEY=xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
PUSHER_APP_ID=1234567
PUSHER_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Vercel ───────────────────────────────────────────────────────────────────
# Add all four variables above in your Vercel project → Settings → Environment Variables
# then redeploy (or run `vercel env pull` locally to copy them into .env.local)
